rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // 관리자: Firebase 콘솔에서 admins/{내 UID} 문서를 직접 만든 계정만
    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function hasPass(uid) {
      let path = /databases/$(database)/documents/entitlements/$(uid);
      return exists(path) && get(path).data.expiresAt > request.time;
    }
    // 오늘 날짜(한국 시간) 20261008 형태
    function kstDay() {
      let t = request.time + duration.value(9, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }
    function okRegion(d) {
      return !('region' in d) || d.region in ['', '서울', '부산', '대구', '인천', '광주', '대전', '울산', '세종',
        '경기', '강원', '충북', '충남', '전북', '전남', '경북', '경남', '제주', '해외'];
    }
    function shortText(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    // 관리자 명단: 본인 것만 확인 가능, 추가·삭제는 콘솔에서만
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // 부모 계정
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'over14', 'region', 'createdAt', 'updatedAt'])
        && request.resource.data.over14 == true
        && okRegion(request.resource.data);

      // 아이 프로필: 별명과 학년만
      match /children/{childId} {
        allow read: if isOwner(uid) || isAdmin();
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['nickname', 'grade', 'createdAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 12
          && request.resource.data.grade is int
          && request.resource.data.grade >= 1
          && request.resource.data.grade <= 6;

        // 역별 기록
        match /progress/{stationId} {
          allow read: if isOwner(uid) || isAdmin();
          allow delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['status', 'updatedAt', 'note'])
            && request.resource.data.status in ['passed', 'stuck', 'visited']
            && request.resource.data.updatedAt == request.time
            && (!('note' in request.resource.data)
                || (request.resource.data.note is string
                    && request.resource.data.note.size() <= 300));
        }
      }
    }

    // 관리자 화면: 아이 학년 분포(별명은 화면에 표시하지 않음)
    match /{path=**}/children/{childId} {
      allow read: if isAdmin();
    }

    // 사이트 글(시작 화면·공지): 누구나 읽기, 관리자만 고치기
    match /site/{docId} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if isAdmin() && docId == 'intro'
        && request.resource.data.keys().hasOnly(['sub', 'lead', 'step1t', 'step1', 'step2t', 'step2', 'step3t', 'step3',
             'story', 'sign', 'who', 'note', 'notice', 'updatedAt', 'updatedBy'])
        && shortText(request.resource.data, 'sub', 120)
        && shortText(request.resource.data, 'lead', 400)
        && shortText(request.resource.data, 'step1t', 40) && shortText(request.resource.data, 'step1', 300)
        && shortText(request.resource.data, 'step2t', 40) && shortText(request.resource.data, 'step2', 300)
        && shortText(request.resource.data, 'step3t', 40) && shortText(request.resource.data, 'step3', 300)
        && shortText(request.resource.data, 'story', 4000)
        && shortText(request.resource.data, 'sign', 80)
        && shortText(request.resource.data, 'who', 1500)
        && shortText(request.resource.data, 'note', 400)
        && shortText(request.resource.data, 'notice', 200)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // 이용 통계: 사람을 알 수 없는 숫자만. 오늘 날짜 칸에 +1씩만 가능
    // stats/{20261008}/c/{항목} = { n: 숫자 }
    match /stats/{day}/c/{key} {
      function okKey() {
        return key.matches('^(visit|pv|v_(today|diag|map|print|record|intro)|d_(phone|tablet|pc)|tz_(kr|other)|lang_(ko|other)|pwa|h(0[0-9]|1[0-9]|2[0-3])|intro_(start|sample)|diag_(start|done)|signup|login|child_add|fb|ws_open|ws_[1-7]|st_open|mk_(pass|stuck)|pr_open|pr_(guide|checkA|checkB|ga|na|da|A|B|key|report|book|book-extra|gate))$')
          || key.matches('^(st|sk|ps)_[1-6]-[0-9]{2}$');
      }
      function okDay() { return day.matches('^20[0-9]{6}$') && int(day) == kstDay(); }
      allow read: if isAdmin();
      allow create: if okDay() && okKey()
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if okDay() && okKey()
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // 이용권: 본인·관리자는 읽기만, 쓰기는 서버 함수만
    // (RevenueCat 웹훅 → Cloud Functions가 구글·애플 구독과 웹 쿠폰을 여기에 기록)
    match /entitlements/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // 구독·쿠폰 거래 기록: 본인 것만 읽기, 쓰기는 서버 함수만
    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 쿠폰: 브라우저는 읽지도 못함(코드 목록 노출 방지)
    match /coupons/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 유료 콘텐츠: 이용권 있는 계정만 읽기
    match /premium/{stationId} {
      allow read: if signedIn() && (hasPass(request.auth.uid) || isAdmin());
      allow write: if false;
    }

    // 의견: 쓰기는 본인, 읽기는 관리자
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'stationId', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && shortText(request.resource.data, 'stationId', 10)
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 감사 기록: 서버만 쓰고 관리자만 읽기
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
